        {"track": "so-what", "days_ago": 400, "ms": 545000, "completed": true},
        {"track": "paranoid", "days_ago": 200, "ms": 200000, "completed": false},
        {"track": "paranoid", "days_ago": 3, "ms": 10000, "completed": false},
        {"track": "paranoid", "days_ago": 2, "ms": 10000, "completed": false},
        {"track": "autumn", "days_ago": 5, "ms": 20000, "completed": false}
      ],
      "likes": [
        {"track": "so-what", "liked": true, "deleted": false},
        {"track": "paranoid", "liked": false, "deleted": false},
        {"track": "autumn", "liked": true, "deleted": true}
      ]
    },
    "thresholds": {
      "tracks": [
        {"key": "long", "title": "long", "artist": "A", "album": "A", "album_artist": "A", "duration_ms": 1200000, "year": null, "genres": []},
        {"key": "short", "title": "short", "artist": "A", "album": "A", "album_artist": "A", "duration_ms": 180000, "year": null, "genres": []},
        {"key": "unknown", "title": "unknown", "artist": "A", "album": "A", "album_artist": "A", "duration_ms": null, "year": null, "genres": []}
      ],
      "plays": [
        {"track": "short", "days_ago": 1, "ms": 90000, "completed": false},
        {"track": "short", "days_ago": 2, "ms": 60000, "completed": false},
