{
  "about": "Smart playlist parity: rule sets, small libraries and the songs each gives, taken from the Aoide apps' own tests (Linux aoide-store tests/smart_playlist.rs, a port of iOS SmartPlaylistTests.swift). Tracks are named by key; ties in order go by track id as text, and each library's ids follow its keys' order, as the apps' do. Times are milliseconds; a play is days before `now`, lasting `ms`; `at_days` moves the clock a case is worked out at.",
  "now": 1700000000000,
  "libraries": {
    "four": {
      "tracks": [
        {"key": "autumn", "title": "Autumn Leaves", "artist": "Bill Evans", "album": "Portrait in Jazz", "album_artist": null, "duration_ms": 350000, "year": 1960, "genres": ["Jazz", "Bebop"]},
        {"key": "paranoid", "title": "Paranoid Android", "artist": "Radiohead", "album": "OK Computer", "album_artist": "Radiohead", "duration_ms": 383000, "year": 1997, "genres": ["Alternative Rock"]},
        {"key": "so-what", "title": "So What", "artist": "Miles Davis", "album": "Kind of Blue", "album_artist": "Miles Davis", "duration_ms": 545000, "year": 1959, "genres": ["Jazz", "Modal"]},
        {"key": "xtal", "title": "Xtal", "artist": "Aphex Twin", "album": "Selected Ambient Works", "album_artist": "Aphex Twin", "duration_ms": 293000, "year": 1992, "genres": ["Electronic"]}
      ],
      "plays": [
        {"track": "so-what", "days_ago": 1, "ms": 545000, "completed": true},
