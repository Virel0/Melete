# Copy to .env next to compose.yaml on the media server. Never commit .env.
#
# This file holds what must exist before Melete starts: the folders, the TMDB token and other
# keys and passwords, and the connections to the seedbox and other services. Everything else is
# usually set in the web UI (Settings → Outside services); those settings are listed below
# commented out, and are optional. A value given here wins over the web UI and can't be changed
# there, so uncomment one only to fix it for good. An empty value leaves the setting to the UI.

# The image compose.yaml runs: the release it names when unset. Set it to pin a version, or a
# digest as the release page gives it (see README.md, Checking a release), such as
# ghcr.io/virel0/melete:0.9.5@sha256:<digest>.
#MELETE_IMAGE=ghcr.io/virel0/melete:0.9.5
# Building from this repository instead, for development: add compose.build.yaml (keep any
# other optional files after it, separated by ":").
#COMPOSE_FILE=compose.yaml:compose.build.yaml

# Transcoding runs on the CPU unless set otherwise. With an NVIDIA GPU, add compose.nvidia.yaml:
# it gives Melete the GPU and transcodes on it (the host needs the NVIDIA Container Toolkit).
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml
# What transcodes run on, when you want to say: none (the CPU) or nvenc (an NVIDIA GPU, with
# compose.nvidia.yaml). Unset: the CPU, or the GPU once compose.nvidia.yaml is added.
#MELETE_HWACCEL=none

# Adding or dropping a library: a compose.local.yaml of your own, added last to COMPOSE_FILE
# (see README.md, Other library folders), such as
#COMPOSE_FILE=compose.yaml:compose.nvidia.yaml:compose.local.yaml

# The uid:gid Melete runs as: 10001:10001, the image's own user, when unset. To keep a library
# where it is, owned by someone else, run as its owner instead, such as 1000:1000 (see README.md,
# Running as another user). The optional containers that share Melete's files run as it too.
# "Melete's user" below means this one.
#MELETE_USER=1000:1000

# The host's folders compose.yaml mounts. The config and transcode folders must be writable by
# Melete's user; the libraries are mounted read-only, and Melete's user must be able to read them.
MELETE_CONFIG_DIR=/path/to/melete/config
MELETE_TRANSCODE_DIR=/path/to/melete/transcode
MELETE_MOVIES_DIR=/path/to/movies
MELETE_SHOWS_DIR=/path/to/shows
MELETE_ANIME_DIR=/path/to/anime
MELETE_MUSIC_DIR=/path/to/music

# TMDB → Settings → API → "API Read Access Token" (the long one, not the API key).
MELETE_TMDB_TOKEN=
# Optional, usually set in Settings: titles, summaries, episode names and logos in this language
# and region, such as fr-FR; English (en-US) when unset. What TMDB hasn't translated comes in
# English.
#MELETE_METADATA_LANGUAGE=fr-FR

# Optional, usually set in Settings: how often every library is scanned whole, which wakes every
# disk it's on: every so many hours (6h when unset, or 24h...) or once a day at a time on the
# server's clock, such as 04:00. What Melete imports is scanned at once either way, only its
# folder.
#MELETE_SCAN_SCHEDULE=04:00

# A FlareSolverr (https://github.com/FlareSolverr/FlareSolverr), or a solver that copies its API
# such as Byparr, for trackers behind a browser check (Uindex, AnimeTosho's feed):
# e.g. http://flaresolverr:8191. Off when empty. compose.flaresolverr.yaml runs one beside
# Melete and sets this itself.
MELETE_FLARESOLVERR_URL=

# Downloading through Deluge on the seedbox: the Deluge web UI's address (as the media server
# reaches it) and its password. Grabbing is off until turned on in Settings (or here).
#MELETE_DOWNLOADS=on
MELETE_DELUGE_URL=
MELETE_DELUGE_PASSWORD=
# Optional, usually set in Settings: removing a torrent Melete added from Deluge once everything
# it brought is in the library: never (the default), kept_data (its files stay on the seedbox)
# or with_data (Deluge deletes them too). It can first wait for a share ratio or a number of
# hours seeding, whichever comes first.
#MELETE_DELUGE_REMOVE=never
#MELETE_DELUGE_REMOVE_RATIO=1.5
#MELETE_DELUGE_REMOVE_SEED_HOURS=72

# The seedbox's SFTP. Leave MELETE_SEEDBOX_HOST empty to keep finished downloads on
# the seedbox; once it's set, all of these are needed.
# The host key is pinned: a seedbox presenting any other key gets nothing. To see the key it
# presents (nothing is sent), run: docker compose run --rm melete melete seedbox host-key <host> <port>
# and check it with your provider before pasting it here.
MELETE_SEEDBOX_HOST=
# 22 when empty.
MELETE_SEEDBOX_PORT=
MELETE_SEEDBOX_USER=
MELETE_SEEDBOX_PASSWORD=
MELETE_SEEDBOX_HOST_KEY=
# Deluge's folder for finished torrents, then the same folder as SFTP shows it, such as
# /home/user/Completed=/Completed.
MELETE_SEEDBOX_PATHS=

# Optional, usually set in Settings: matching the music library to MusicBrainz (on or off; off
# by default). Album and track names leave the server.
#MELETE_MUSICBRAINZ=on
# Optional, usually set in Settings: covers of music not in the library, in searches for music
# to request (on or off; off by default; needs MusicBrainz on). The release group's id of each
# album or song shown goes to the Cover Art Archive when its cover is first asked for, once;
# the cover is cached, those a search showed for 30 days, 2000 at most.
#MELETE_SEARCH_COVERS=on
# Optional, usually set in Settings: artists' portraits from Wikimedia Commons, with their author
# and licence, in searches for music to request and for the library's artists (on or off; off by
# default; needs MusicBrainz on). For an artist not looked up before, its id goes to MusicBrainz
# for its Wikidata link, the item's id to wikidata.org and its image's file name to Wikimedia
# Commons; the library's artists are looked up in the background, 20 an hour, except those with
# artist.jpg or folder.jpg above their albums. The portrait is cached, those a search showed for
# 30 days, 2000 at most, and the library's artists while they're in it.
#MELETE_ARTIST_PORTRAITS=on
# Optional, usually set in Settings: For You, songs for each person from what they've played,
# some in the library and some to request, from ListenBrainz (on or off; off by default; needs
# MusicBrainz on). Only MusicBrainz ids are sent: those of the recordings and artists each person
# played most in the last 90 days to labs.api.listenbrainz.org, and of the artists alongside and
# the recordings suggested to api.listenbrainz.org, for their most listened-to recordings and for
# their artists and album. Never a name, an account, play counts or titles. Lists are made in the background, again at most once a day; answers are kept a week.
#MELETE_LISTENBRAINZ=on

# Optional, usually set in Settings: lyrics from LRCLIB (lrclib or off; off by default): synced
# lyrics for albums Melete imports, and lyrics the apps ask for of tracks without their own.
# Each such track's title, artist, album and length are sent to lrclib.net, once per track.
#MELETE_LYRICS=lrclib

# Translating lyrics through LibreTranslate (off when empty): its address, and an API key if
# it wants one. The lines of each song translated are sent to it; run one yourself to keep
# them at home: compose.libretranslate.yaml runs one beside Melete and sets the address itself,
# loading the languages below (fewer start faster).
MELETE_LIBRETRANSLATE_URL=
MELETE_LIBRETRANSLATE_API_KEY=
#MELETE_LIBRETRANSLATE_LANGUAGES=en,ja,ko,zh,es,fr,de,pt,it,ru

# Optional, usually set in Settings: lyrics' pronunciation in Latin letters for Japanese, Korean
# and Cyrillic, for apps that ask (on or off; off by default). Worked out on the server; nothing
# is sent anywhere.
#MELETE_LYRICS_ROMANISATION=on

# Optional, usually set in Settings: once a requested song is in, want its album too, fetched
# after other work (on or off; off by default). A song found only inside an album fetches that
# album either way.
#MELETE_SONG_ALBUMS=on

# Ways in (see docs/REMOTE-ACCESS.md): which parts of Melete each way of reaching it opens,
# by the address connections come from. Separated by ";", each a name, its addresses or ranges
# (comma-separated) and what it opens (video, music, requests, admin, or all). Signing in and
# the web page go through every way. Empty: every address reaches everything.
# A way can hold video to a limit, in bits per second (max=8M): files over it are converted.
#   MELETE_WAYS_IN=home 192.168.0.0/24 all; wireguard 10.10.0.0/24 all max=8M; vps 10.20.0.1 music,requests
MELETE_WAYS_IN=
# Splitting music into its parts on the GPU (voice, drums, bass, guitar, other), for the Auto
# DJ and sing-along: add compose.stems.yaml to COMPOSE_FILE. Three folders, each writable by
# Melete's user (sudo install -d -o 10001 -g 10001 <folder>, with MELETE_USER's uid and gid if
# set): the parts, about 2.4 times the music library's size; the job files Melete and the separator share; and the models, downloaded once.
# The separator is this version's release unless named here, e.g. one built with
#   docker build -t melete-stems:dev ./stems
#MELETE_STEMS_IMAGE=melete-stems:dev
MELETE_STEMS_DATA_DIR=/path/to/stems
MELETE_STEMS_JOBS_DIR=/path/to/stems-jobs
MELETE_STEMS_MODELS_DIR=/path/to/stems-models

# Titles' trailers from YouTube, downloaded once, converted on the GPU and kept while the title is
# in the library: add compose.vpn.yaml (the VPN; the downloader shares its network) and
# compose.trailers.yaml to COMPOSE_FILE, then turn them on in Settings, where the quality is set
# (4K, 1080p or 720p). One folder, writable by Melete's user: the job files Melete and the
# downloader share. The trailers themselves go in Melete's config folder, 100 to 300 MB each.
# The downloader is this version's release unless named here, e.g. one built with
#   docker build -t melete-trailers:dev ./trailers
#MELETE_TRAILERS_IMAGE=melete-trailers:dev
MELETE_TRAILER_JOBS_DIR=/path/to/trailer-jobs

# A gallery of profile pictures to pick from (compose.avatars.yaml): a folder with one subfolder
# per category, which Melete only reads.
#MELETE_AVATARS_DIR=/path/to/avatars

# Reverse proxies trusted to say who their clients are (X-Forwarded-For), e.g. a VPS's tunnel
# address. No one else's word is taken.
MELETE_TRUSTED_PROXIES=

# Soulseek through slskd (0.26 or later), off when the address is empty. Album searches then ask
# Soulseek too; the search words go to the Soulseek network under slskd's account.
#
# The easy way is compose.soulseek.yaml, which runs slskd behind the VPN of compose.vpn.yaml
# (below) and sets the address itself. To use it, add both to COMPOSE_FILE, the VPN first, and
# fill in everything below and the VPN's section:
# COMPOSE_FILE=compose.yaml:compose.vpn.yaml:compose.soulseek.yaml
#
# Melete's key for slskd's API, 16 to 255 characters (e.g. `openssl rand -hex 24`). It needs
# slskd's ReadWrite role and no more; compose.soulseek.yaml gives it that role. Running slskd
# some other way, list it in slskd's web.authentication.api_keys with `role: ReadWrite`.
MELETE_SLSKD_API_KEY=
# Only when running slskd some other way: its API as Melete's container reaches it, and its
# downloads folder as mounted in Melete's container (writable by Melete's user; finished downloads
# wait there until it's set).
MELETE_SLSKD_URL=
MELETE_SLSKD_DOWNLOADS=
# The Soulseek account slskd signs in with, and a login for slskd's own web UI.
MELETE_SOULSEEK_USERNAME=
MELETE_SOULSEEK_PASSWORD=
MELETE_SLSKD_WEB_USERNAME=
MELETE_SLSKD_WEB_PASSWORD=
# slskd's own folder and its finished downloads; both writable by Melete's user:
#   sudo install -d -o 10001 -g 10001 <folder>   (or MELETE_USER's uid and gid)
MELETE_SLSKD_APP_DIR=/path/to/slskd/app
MELETE_SLSKD_DOWNLOADS_DIR=/path/to/slskd/downloads
# The key slskd uses to ask Gluetun whether the VPN is up: the slskd role's key in Gluetun's
# roles file (below).
MELETE_GLUETUN_CONTROL_KEY=

# A VPN beside Melete (compose.vpn.yaml): Gluetun, with WireGuard or OpenVPN, shared by Soulseek,
# the trailer downloader and the services Melete sends through its proxy. Add it to COMPOSE_FILE
# before the files that use it:
# COMPOSE_FILE=compose.yaml:compose.vpn.yaml
# Then under Settings, Outside services: Proxy (HTTP, host gluetun, port 8888, user melete and
# the password below) to choose what goes through it, and VPN (http://gluetun:8000 and Melete's
# key) to see how it is and start, stop or restart it. Melete never holds the VPN's own keys.
#
# A file of Gluetun's settings for your VPN provider, kept beside this one and never committed,
# e.g. .env.gluetun with VPN_SERVICE_PROVIDER, VPN_TYPE and that provider's keys
# (https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers).
MELETE_GLUETUN_ENV_FILE=.env.gluetun
# The password of Gluetun's HTTP proxy, user melete (`openssl rand -hex 24`). Gluetun logs a login
# it turns down, so when changing it, change it in Melete's Proxy settings first.
MELETE_GLUETUN_PROXY_PASSWORD=
# Who may use Gluetun's control server: a copy of gluetun-roles.example.toml kept outside the
# repository, with a key of its own for slskd and for Melete (its keys are empty, and Gluetun
# won't start until both are set). With it, no route answers without a key, and Melete refuses a
# control server that does. Which servers the VPN uses (SERVER_COUNTRIES and the rest) goes in
# the Gluetun settings file above.
MELETE_GLUETUN_ROLES_FILE=/path/to/gluetun-roles.toml
